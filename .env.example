# ---- network (testnet 456 is the default; do not change these on testnet)
KERSTA_NETWORK=test
KERSTA_NETUID=456
# Optional: your own node, and a node that keeps old state (deadline snapshots).
# KERSTA_ENDPOINT=ws://127.0.0.1:9944
# KERSTA_ARCHIVE_ENDPOINT=wss://archive.chain.opentensor.ai:443

# ---- wallet
KERSTA_WALLET_NAME=default
KERSTA_WALLET_HOTKEY=default
KERSTA_WALLET_PATH=~/.bittensor/wallets
# Non interactive unlock (SDK 11): BT_WALLET_PASSWORD or BT_WALLET_PASSWORD_FILE

# ---- validator
KERSTA_HOME=/var/lib/kersta
KERSTA_TESTSET_URL=https://testsets.kersta.ai
# KERSTA_TESTSET_TOKEN=
# KERSTA_REPORT_URL=https://api.kersta.ai/v1/reports
KERSTA_GPU=0
KERSTA_SANDBOX_MEMORY=48g
KERSTA_SANDBOX_CPUS=8
# KERSTA_SANDBOX_IMAGE=ghcr.io/kersta-ai/sandbox:1
# HF_TOKEN=            # raises Hugging Face download rate limits

# ---- owner only
# KERSTA_TESTSET_SEED= # secret; never on a validator or in git
